{% set items = [] %}
{% for item in content.field_hero_slider_items %}
    {% if item['#paragraph'] %}
         {% set items = items|merge([item]) %}
    {% endif %}
{% endfor %}


{%
  set classes = [
    'component-card-hero-slider',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
  ]
%}
{% block paragraph %}
  <div{{ attributes.addClass(classes) }}>
    {% block content %}
        <div class="card__container">


          <div class="slider-nav">
          {% for item in paragraph.field_hero_slider_items %}
            {% set slide = item.entity %}

            

              {# Image #}
              {% if slide.field_simple_media %}
                {# Define media #}
                {% set media_entity = slide.field_simple_media.entity %}
                {% set image = media_entity.field_media_image.entity %}
                {% set media = image.uri.value|file_url %}
                {# <div class="card__media" style="background-image: url('{{ media }}')"></div> #}
                <div class="card__media">
                  <img src="{{ media }}">
                </div>
              {% endif %}
          {% endfor %}
          </div>

          
          <div class="slider-for">
            {{items}}
          </div>


        </div>


    {% endblock %}
  </div>
{% endblock paragraph %}
