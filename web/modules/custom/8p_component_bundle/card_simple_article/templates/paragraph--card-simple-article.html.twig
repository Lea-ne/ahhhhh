
{# Paragraph template for Card Basic Content #}
{% set title = content.field_cp_title %}
{% set text = content.field_cp_text %}
{% set link_url = content.field_cp_link[0]['#url'] %}
{% set link_title = content.field_cp_link[0]['#title'] %}

{# Define options #}
{% set custom_id = paragraph.field_cp_custom_id.0.value %}
{% set custom_class = paragraph.field_cp_custom_class.0.value %}

{# Define media #}
{% set media_entity = paragraph.field_cp_image.entity %}
{% set image = media_entity.field_media_image.entity %}
{% set media = image.uri.value|file_url %}


{%
  set classes = [
    'component-card-article',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    custom_class,
  ]
%}


{% include '@component_bundle/card_simple_article/templates/card-simple-article.html.twig' with {
    classes: classes,
    custom_id: custom_id,
    title: title,
    text: text,
    media: media,
    link_url: link_url, 
    link_title: link_title,
} %} 
{# Note to include : component_bundle has to be the machine name of the module #}