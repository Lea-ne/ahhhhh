{# Paragraph template values #}
{% set title = content.field_cp_title %}
{% set text = content.field_cp_text %}
{% set link_url = content.field_cp_link[0]['#url'] %}
{% set link_title = content.field_cp_link[0]['#title'] %}

{# Define options #}
{% set custom_id = paragraph.field_cp_custom_id.0.value %}
{% set custom_class = paragraph.field_cp_custom_class.0.value %}

{# Define media #}
{% set media_entity = paragraph.field_cp_image.entity %}
{% set image = media_entity.field_media_image.entity %}
{% set media = image.uri.value|file_url %}


{%
  set classes = [
    'component-card-feature-icon',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    custom_class,
  ]
%}


{# template #}
<div class="{{ classes|join(' ') }}" {% if custom_id %} id="{{ custom_id }}"{% endif %}>
    <div class="card__container">

       {% if media %}
        <div class="card__media">
          <img src="{{ media }}" alt="{{ media_alt }}">
        </div>
       {% endif %}
      
      <div class="card__content">

        {% if title %}
          <h3 class="card__title">
            {{ title }}
          </h3>
        {% endif %}
        
        {% if text %}
          <div class="card__text">
            {{ text }}
          </div>
        {% endif %}

        {% if link_title %}
          <div class="card__link">
            <a href="{{ link_url }}">{{ link_title }}</a>
          </div>
        {% endif %}
      </div>
    </div>
</div>


